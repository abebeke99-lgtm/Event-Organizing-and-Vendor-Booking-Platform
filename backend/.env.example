PORT=4000
NODE_ENV=development
# Comma-separated browser origins allowed to call the API.
WEB_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
CLIENT_URL=http://127.0.0.1:5173
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=event_admin
DB_PASSWORD=change-me
DB_NAME=event_platform
# Local XAMPP uses DB_SSL=false. Render/Aiven production must use DB_SSL=true and a valid Aiven CA.
DB_SSL=false
# Leave blank only for local development with DB_SSL=false; production requires the CA certificate PEM.
DB_SSL_CA=
# Production cookies are always Secure + SameSite=None.
COOKIE_SECURE=false
COOKIE_SAME_SITE=strict
# SMTP account used to send password reset OTPs (port 465 for implicit TLS, 587 for STARTTLS).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=EventFlow <no-reply@example.com>
FRONTEND_URL=http://localhost:5173
# Optional module under src/providers/ implementing createPaymentProvider().
# Keep provider credentials in the process environment; never put them in the database.
PAYMENT_PROVIDER_ADAPTER=
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_NAME=Platform Admin
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-long-random-password
