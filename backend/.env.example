PORT=4000
NODE_ENV=development
# Comma-separated browser origins allowed to call the API.
WEB_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=event_admin
DB_PASSWORD=change-me
DB_NAME=event_platform
DB_SSL=false
# Optional CA certificate in PEM format when the database CA is not system-trusted.
DB_SSL_CA=
# Production cookies are always Secure + SameSite=None.
COOKIE_SECURE=false
COOKIE_SAME_SITE=strict
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_NAME=Platform Admin
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-long-random-password
