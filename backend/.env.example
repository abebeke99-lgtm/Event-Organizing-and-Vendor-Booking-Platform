# Runtime configuration
# Local development: use the same hostname for the frontend and API
# (for example 127.0.0.1 for both), with COOKIE_SECURE=false and
# COOKIE_SAME_SITE=lax. Do not mix localhost and 127.0.0.1 for a session.
# Render + Netlify: use the exact Netlify origin in WEB_ORIGIN and FRONTEND_URL,
# with COOKIE_SECURE=true and COOKIE_SAME_SITE=none for cross-site API cookies.
PORT=4000
NODE_ENV=production
WEB_ORIGIN=https://your-site.netlify.app
COOKIE_SECURE=true
COOKIE_SAME_SITE=none
# For local development use NODE_ENV=development, COOKIE_SECURE=false, and COOKIE_SAME_SITE=lax.

# The application and migrations use Neon PostgreSQL only.
# Runtime uses the pooled endpoint; migrations use the direct endpoint.
# Both URLs must point to the same Neon project and use TLS.
DB_DIALECT=postgres
DATABASE_URL=
DIRECT_URL=
DB_SSL=true
DB_SSL_CA=
DB_SSL_CA_BASE64=

# Neon test migrations use separate pooled and direct URLs from the ignored backend/.env.neon-test file.

# Reserved for signed-session/JWT integrations; this app currently uses DB-backed random session tokens.
SESSION_SECRET=replace-with-a-long-random-value

# Set a real key only in the ignored backend/.env; never use a placeholder or VITE_ variable.
OPENAI_API_KEY=replace_with_your_real_openai_api_key
OPENAI_MODEL=gpt-4o-mini
OPENAI_CHAT_MODELS=gpt-4o-mini

# Optional SMTP account for password resets (port 465 for implicit TLS, 587 for STARTTLS).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=EventHub <no-reply@example.com>
SMTP_SECURE=
# Generate and store a private random secret of at least 32 bytes; never commit a value here.
OTP_HMAC_SECRET=
OTP_EXPIRY_MINUTES=10
FRONTEND_URL=https://your-site.netlify.app

# Optional Google and Microsoft sign-in; callbacks must exactly match the provider console and API routes.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://127.0.0.1:4000/api/platform/oauth/google/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
MICROSOFT_CALLBACK_URL=http://127.0.0.1:4000/api/platform/oauth/microsoft/callback

# Optional payment adapter module under src/providers/.
PAYMENT_PROVIDER_ADAPTER=

# Optional private bootstrap administrator values.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_NAME=
ADMIN_BOOTSTRAP_PASSWORD=

# Neon test database seeding; configure locally before running npm run seed.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Set all three to seed sample accounts/data; omit all three for an administrator-only seed.
# Sample passwords must be at least 24 characters with uppercase, lowercase, and digits (bcrypt limit: 72 bytes).
SEED_ORGANIZER_PASSWORD=
SEED_VENDOR_PASSWORD=
SEED_CUSTOMER_PASSWORD=
