# Runtime configuration
PORT=4000
NODE_ENV=production
WEB_ORIGIN=https://your-site.netlify.app
COOKIE_SECURE=true
COOKIE_SAME_SITE=none
# For local development use NODE_ENV=development, COOKIE_SECURE=false, and COOKIE_SAME_SITE=lax.

# Configure either DATABASE_URL or all five DB_* values below.
# MySQL is the default. For PostgreSQL, set DB_DIALECT=postgres and use a PostgreSQL DATABASE_URL.
# For local Neon runtime testing, use the pooled DATABASE_URL with DB_SSL=true; keep MySQL as the production default until cutover is approved.
# Set DIRECT_URL only for PostgreSQL migration commands; never use it as the application runtime URL.
# PostgreSQL connections verify TLS certificates by default. Set DB_SSL=false only for local development.
DB_DIALECT=postgres
DATABASE_URL=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=eventhub
DB_USER=postgres
DB_PASSWORD=replace-with-database-password
# Required in production; DB_SSL_CA and DB_SSL_CA_BASE64 are optional.
DB_SSL=true
DB_SSL_CA=
DB_SSL_CA_BASE64=

# Neon test migrations use separate pooled and direct URLs from the ignored backend/.env.neon-test file.
# DB_DIALECT=postgres

# Reserved for signed-session/JWT integrations; this app currently uses DB-backed random session tokens.
SESSION_SECRET=replace-with-a-long-random-value

# Set a real key only in the ignored backend/.env; never use a placeholder or VITE_ variable.
OPENAI_API_KEY=replace_with_your_real_openai_api_key
OPENAI_MODEL=gpt-4o-mini
OPENAI_CHAT_MODELS=gpt-4o-mini

# Optional SMTP account for password resets (port 465 for implicit TLS, 587 for STARTTLS).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=EventHub <no-reply@example.com>
SMTP_SECURE=
FRONTEND_URL=https://your-site.netlify.app

# Optional payment adapter module under src/providers/.
PAYMENT_PROVIDER_ADAPTER=

# Optional private bootstrap administrator values.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_NAME=
ADMIN_BOOTSTRAP_PASSWORD=

# Neon test database seeding; configure locally before running npm run seed.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Set all three to seed sample accounts/data; omit all three for an administrator-only seed.
# Sample passwords must be at least 24 characters with uppercase, lowercase, and digits (bcrypt limit: 72 bytes).
SEED_ORGANIZER_PASSWORD=
SEED_VENDOR_PASSWORD=
SEED_CUSTOMER_PASSWORD=

# Legacy MySQL seed:users script only; do not use this variable for the Neon seed.
SEED_ADMIN_PASSWORD=
