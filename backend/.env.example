# Runtime configuration
PORT=4000
NODE_ENV=production
WEB_ORIGIN=https://your-site.netlify.app
COOKIE_SECURE=true
COOKIE_SAME_SITE=none
# For local development use NODE_ENV=development, COOKIE_SECURE=false, and COOKIE_SAME_SITE=lax.

# Configure either DATABASE_URL or all five DB_* values below.
DATABASE_URL=
DB_HOST=your-mysql-host
DB_PORT=3306
DB_NAME=your_database
DB_USER=your_database_user
DB_PASSWORD=replace-with-database-password
# Required in production; DB_SSL_CA and DB_SSL_CA_BASE64 are optional.
DB_SSL=true
DB_SSL_CA=
DB_SSL_CA_BASE64=

# Reserved for signed-session/JWT integrations; this app currently uses DB-backed random session tokens.
SESSION_SECRET=replace-with-a-long-random-value

# Server-side OpenAI key; never expose this as a VITE_ variable.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_CHAT_MODELS=gpt-4o-mini

# Optional SMTP account for password resets (port 465 for implicit TLS, 587 for STARTTLS).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=EventHub <no-reply@example.com>
SMTP_SECURE=
FRONTEND_URL=https://your-site.netlify.app

# Optional payment adapter module under src/providers/.
PAYMENT_PROVIDER_ADAPTER=

# Optional private bootstrap administrator values.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_NAME=
ADMIN_BOOTSTRAP_PASSWORD=

# Set all four to unique 12-72 byte values before running npm run seed:users.
SEED_ADMIN_PASSWORD=
SEED_ORGANIZER_PASSWORD=
SEED_VENDOR_PASSWORD=
SEED_CUSTOMER_PASSWORD=
