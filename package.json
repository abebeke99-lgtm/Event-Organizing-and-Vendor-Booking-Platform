  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm --workspace backend run dev",
    "dev:web": "npm --workspace frontend run dev",
    "start": "npm --workspace backend start",
    "build": "npm --workspace frontend run build",
    "test": "npm --workspace backend test && npm --workspace frontend test",
    "migrate": "npm --workspace backend run migrate",
    "seed:users": "npm --workspace backend run seed:users",
    "db:init": "npm --workspace backend run db:init",
    "bootstrap:admin": "npm --workspace backend run bootstrap:admin",
    "db:check": "npm --workspace backend run db:check",
    "smtp:check": "npm --workspace backend run smtp:check"
  },
  "engines": {
    "node": "20.x"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "description": "This project delivers a full-stack event marketplace and booking platform for organizers, vendors, customers, and administrators. It follows the documented business requirements for event planning, vendor discovery, booking workflows, payments, reviews, and administrative oversight.",
