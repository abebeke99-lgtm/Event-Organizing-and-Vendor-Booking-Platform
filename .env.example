PORT=4000
NODE_ENV=development
# Comma-separated frontend origins allowed to call the API.
WEB_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=eventhub
DB_USER=postgres
DB_PASSWORD=change-me
# Set these only when the managed MySQL provider requires TLS.
DB_SSL=false
# Optional CA certificate in PEM format when the database CA is not system-trusted.
DB_SSL_CA=
COOKIE_SECURE=false
# Use none only when the frontend is hosted on a different site; HTTPS is then required.
COOKIE_SAME_SITE=strict
# SMTP account used to send password reset OTPs (port 465 for implicit TLS, 587 for STARTTLS).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=EventHub <no-reply@example.com>
# Optional: true enables implicit TLS; defaults to true on port 465 and STARTTLS otherwise.
SMTP_SECURE=
FRONTEND_URL=http://localhost:5173
# Server-side OpenAI key; never expose this as a VITE_ variable.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_CHAT_MODELS=gpt-4o-mini
# Set privately before running npm run bootstrap:admin; do not commit real values.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_NAME=
ADMIN_BOOTSTRAP_PASSWORD=
