PORT=4000
NODE_ENV=development
# Comma-separated frontend origins allowed to call the API.
CORS_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=event_platform
DB_USER=event_admin
DB_PASSWORD=change-me
# Set these only when the managed MySQL provider requires TLS.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
COOKIE_SECURE=false
# Use none only when the frontend is hosted on a different site; HTTPS is then required.
COOKIE_SAME_SITE=strict
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_NAME=Platform Admin
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-long-random-password
