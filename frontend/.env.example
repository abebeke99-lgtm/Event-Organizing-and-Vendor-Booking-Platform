# Local development uses the local /api base; production uses the HTTPS Render API origin.
# Enable browser-only mock registration and predefined demo sign-in locally.
# Never enable demo authentication for a production deployment.
VITE_DEMO_AUTH=false

# Used only when VITE_DEMO_AUTH=false; production may supply the Render origin with or without /api.
VITE_API_URL=http://127.0.0.1:4000/api
