# Local development defaults to http://127.0.0.1:4000/api; production uses the HTTPS Render API origin.
# Enable browser-only mock registration and predefined demo sign-in locally.
# Never enable demo authentication for a production deployment.
VITE_DEMO_AUTH=false

# Used only when VITE_DEMO_AUTH=false; may be an API origin or an origin ending in /api.
# In development, loopback API hostnames automatically match the browser hostname.
VITE_API_URL=http://127.0.0.1:4000/api

# Set each URL only after confirming the corresponding official EventHub profile.
VITE_TELEGRAM_URL=https://t.me/የአንተ_ቻናል
VITE_YOUTUBE_URL=https://youtube.com/@የአንተ_ቻናል
VITE_FACEBOOK_URL=https://facebook.com/የአንተ_ገጽ
VITE_LINKEDIN_URL=https://linkedin.com/company/የአንተ_ገጽ
