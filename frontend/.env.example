# Public API URL only; never put database credentials or private keys in VITE_ variables.
# In development, loopback API hostnames automatically match the browser hostname.
# In production, set VITE_API_URL via build environment variable (e.g., Netlify).
# Production URL must be HTTPS and not use localhost or 127.0.0.1.
VITE_API_URL=http://127.0.0.1:5000/api

# Set each URL only after confirming the corresponding official EventHub profile.
