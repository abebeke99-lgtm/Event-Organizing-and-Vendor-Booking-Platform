# Leave empty in local development to use Vite's /api proxy.
# In production set this to the public HTTPS origin of the API, without /api.
# Enable browser-only mock registration and predefined demo sign-in locally.
# Never enable demo authentication for a production deployment.
VITE_DEMO_AUTH=false

# Used only when VITE_DEMO_AUTH=false.
VITE_API_URL=https://event-organizing-and-vendor-booking.onrender.com
